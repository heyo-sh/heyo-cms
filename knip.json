{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["examples/*"],
  "ignore": ["packages/create-heyo-cms/templates/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/heyo-cms": {
      "entry": [
        "src/index.ts",
        "src/types.ts",
        "src/config.ts",
        "src/fields.ts",
        "src/schema.ts",
        "src/query.ts",
        "src/migrations.ts",
        "src/cli.ts",
        "src/auth.ts",
        "src/uploads.ts",
        "src/editor.ts",
        "src/ai.ts",
        "src/webhooks.ts",
        "src/plugins.ts",
        "src/jobs.ts",
        "src/http.ts",
        "src/client.ts",
        "src/content.ts",
        "src/telemetry.ts",
        "src/adapters/next.ts",
        "src/adapters/astro.ts",
        "src/adapters/react-router.ts",
        "src/adapters/sveltekit.ts",
        "src/adapters/nuxt.ts",
        "src/db/postgres.ts",
        "src/db/sqlite.ts",
        "src/db/d1.ts",
        "src/db/mongodb.ts",
        "test/**/*.test.ts",
        "test/contract/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["pg"]
    },
    "website": {
      "ignoreDependencies": ["shadcn", "tw-animate-css", "tailwindcss"]
    },
    "packages/create-heyo-cms": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/heyo-cms-admin": {
      "entry": [
        "src/index.ts",
        "src/app/main.tsx",
        "test/**/*.test.ts",
        "test/**/*.test.tsx"
      ],
      "project": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css",
        "test/**/*.ts",
        "test/**/*.tsx"
      ]
    }
  }
}
