# Cloudflare R2. Inside a Worker the MEDIA binding in wrangler.json is used
# and none of this is needed; the CLI on your machine has no binding, so it
# reaches the same bucket over R2's S3-compatible API.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.example.com   # a domain in front of the bucket
