# S3. Credentials may also come from an IAM role or ~/.aws, in which case
# only the bucket and the region are needed here.
S3_BUCKET=
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://...      # for MinIO, Tigris, Wasabi, Ceph
# S3_PUBLIC_URL=https://cdn...  # serve from a CDN, write to the bucket
