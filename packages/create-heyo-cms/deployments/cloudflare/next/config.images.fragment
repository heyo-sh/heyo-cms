/**
 * What resizes an uploaded image, and into what.
 *
 * Workers cannot load `sharp`, but they do not need it: the Images binding
 * resizes and converts inside the runtime, so `convert: { to: "webp" }` and
 * the named sizes are rendered here — on the Worker — the same way
 * `sharpImages()` renders them on Node. The binding is declared in
 * `wrangler.json` (`"images": { "binding": "IMAGES" }`). `wrangler dev`
 * simulates it locally and does not apply a crop or a focal point; add
 * `"remote": true` to the binding to see those in development.
 *
 * Sizes are named rather than free: arbitrary dimensions in a URL are how a
 * stranger fills a bucket and burns CPU one pixel at a time.
 */
const images: ImagesConfig = {
  processor: cloudflareImages(imagesBinding),
  convert: { to: "webp", keep: ["image/gif", "image/svg+xml"] },
  quality: 82,
  stripMetadata: true,
  maxDimensions: { width: 3840, height: 3840 },
  focalPoint: true,
  crop: true,
  variants: {
    mode: "on-demand",
    sizes: {
      thumb: { width: 320, height: 320, fit: "cover" },
      card: { width: 768 },
      hero: { width: 1920 },
    },
  },
};

/**
 * The binding, from whichever half of the runtime has it — the same two
 * sources the bucket and the database read. In a deployed Worker
 * `cloudflare:workers` resolves and carries it; a dev server running outside
 * workerd hands it over through the global the mount sets.
 */
async function imagesBinding(): Promise<CloudflareImagesBinding | undefined> {
  const injected =
    (globalThis as { __heyoCloudflareEnv?: Record<string, unknown> }) // prettier-ignore
    .__heyoCloudflareEnv;
  if (injected?.IMAGES) return injected.IMAGES as CloudflareImagesBinding;

  try {
    const module = (await import(/* @vite-ignore */ "cloudflare:workers")) as {
      env?: Record<string, unknown>;
    };
    return module.env?.IMAGES as CloudflareImagesBinding | undefined;
  } catch {
    return undefined;
  }
}
