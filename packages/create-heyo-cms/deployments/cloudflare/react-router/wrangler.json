{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_NAME}}",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client"
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
