---
import { richTextToPlainText } from "@heyo-sh/heyo-cms";

import AdminPanelButton from "../components/admin-panel-button";
import "../styles/ui.css";
import { cachePage, postsTag } from "../../heyo-cms.cache.ts";
import { cms } from "../../heyo-cms.config.ts";

/**
 * The front page, reading the CMS directly.
 *
 * `cms.api` is the same engine the REST route uses — the same access control,
 * the same hooks, the same events — without HTTP or serialisation in between.
 * It is typed from your collections: rename a field in `heyo-cms.config.ts`
 * and this page stops compiling.
 *
 * `cachePage` is the other half of the write hooks in
 * `heyo-cms.config.ts`: this response may be held by whatever is in front of
 * the server until a post changes, at which point the hook purges `posts`
 * and the next reader gets a fresh render. Astro has no cache of its own, so
 * the caching happens where it actually is — the CDN — and the only thing
 * this page owes it is the tag.
 */
export const prerender = false;

const settings = await cms.globals.settings.get();
const { docs } = await cms.api.posts.find({
  where: { kind: "compare", path: "status", operator: "eq", value: "published" },
  orderBy: [{ path: "created_at", direction: "desc" }],
  limit: 10,
});

await cachePage(Astro.response.headers, [postsTag]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{settings.siteName}</title>
    <link rel="stylesheet" href="/home.css" />
    <script src="/home.js" defer is:inline></script>
  </head>
  <body style="margin: 0">
    <main class="cms-home">
      <div class="cms-home-shell">
        <header class="cms-home-header">
          <button class="cms-theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
            <svg class="cms-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z" /></svg>
            <svg class="cms-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </header>

        <section class="cms-hero" aria-labelledby="cms-title">
          <img class="cms-mark" src="/logo.svg" alt="" width="39" height="39" />
          <h1 id="cms-title">{settings.siteName}</h1>
          <p class="cms-description">A starter template powered by Heyo CMS.</p>
          {settings.tagline && <p class="cms-tagline">{settings.tagline}</p>}
          <div class="cms-actions">
            <AdminPanelButton />
          </div>
        </section>

        <footer class="cms-home-footer">
          {docs.length === 0 ? (
            <span>Nothing published yet. Run <code>heyo-cms seed</code> or create a post in the <a href="/api/heyo-cms/admin">panel</a>.</span>
          ) : (
            <span>Scroll to see published posts</span>
          )}
        </footer>
      </div>

      {docs.length > 0 && (
        <section class="cms-posts" aria-labelledby="cms-posts-title">
          <h2 id="cms-posts-title">Latest posts</h2>
          <ul>
            {docs.map((post) => (
              <li>
                <h3>{post.handle ? <a href={`/posts/${post.handle}`}>{post.title}</a> : post.title}</h3>
                <p>{post.excerpt ?? richTextToPlainText(post.body).slice(0, 180)}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
  </body>
</html>
