{
  "name": "@heyo-sh/heyo-cms",
  "version": "0.3.1",
  "description": "Framework-agnostic, TypeScript-first headless CMS with its own panel, RBAC, i18n, native AI and first-class media.",
  "keywords": [
    "cms",
    "headless-cms",
    "typescript",
    "postgres",
    "mongodb",
    "sqlite",
    "cloudflare-workers",
    "vercel"
  ],
  "homepage": "https://heyo.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyo-sh/heyo-cms.git",
    "directory": "packages/heyo-cms"
  },
  "bugs": {
    "url": "https://github.com/heyo-sh/heyo-cms/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "heyo-cms": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "typebox": "1.4.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "^0.73.0",
    "@mariozechner/pi-ai": "^0.73.0",
    "mongodb": "^6.0.0 || ^7.0.0",
    "pg": "^8.0.0",
    "sharp": "^0.33.0 || ^0.34.0 || ^0.35.0"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-agent-core": {
      "optional": true
    },
    "@mariozechner/pi-ai": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "pg": "8.16.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "default": "./dist/fields.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    },
    "./astro": {
      "types": "./dist/adapters/astro.d.ts",
      "default": "./dist/adapters/astro.js"
    },
    "./react-router": {
      "types": "./dist/adapters/react-router.d.ts",
      "default": "./dist/adapters/react-router.js"
    },
    "./sveltekit": {
      "types": "./dist/adapters/sveltekit.d.ts",
      "default": "./dist/adapters/sveltekit.js"
    },
    "./nuxt": {
      "types": "./dist/adapters/nuxt.d.ts",
      "default": "./dist/adapters/nuxt.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./uploads": {
      "types": "./dist/uploads.d.ts",
      "default": "./dist/uploads.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./postgres": {
      "types": "./dist/db/postgres.d.ts",
      "default": "./dist/db/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/db/sqlite.d.ts",
      "default": "./dist/db/sqlite.js"
    },
    "./d1": {
      "types": "./dist/db/d1.d.ts",
      "default": "./dist/db/d1.js"
    },
    "./mongodb": {
      "types": "./dist/db/mongodb.d.ts",
      "default": "./dist/db/mongodb.js"
    }
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "rm -rf dist && bun run build:core && bun run build:types",
    "build:core": "bun build src/index.ts src/types.ts src/config.ts src/fields.ts src/schema.ts src/query.ts src/migrations.ts src/auth.ts src/uploads.ts src/editor.ts src/ai.ts src/webhooks.ts src/plugins.ts src/jobs.ts src/http.ts src/client.ts src/content.ts src/telemetry.ts src/cli.ts src/adapters/next.ts src/adapters/astro.ts src/adapters/react-router.ts src/adapters/sveltekit.ts src/adapters/nuxt.ts src/db/postgres.ts src/db/sqlite.ts src/db/d1.ts src/db/mongodb.ts --outdir dist --root src --target node --production --splitting --external zod --external pg --external mongodb --external sharp --external @mariozechner/pi-ai --external @mariozechner/pi-agent-core --external typebox",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  }
}
